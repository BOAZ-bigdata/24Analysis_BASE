    {
      "cell_type": "code",
      "source": [
        "def test(model, device, test_loader):\n",
        "    model.eval()  # 평가 모드 설정\n",
        "    test_loss = 0\n",
        "    correct = 0\n",
        "    with torch.no_grad():  # 그래디언트 계산 비활성화\n",
        "        for data, target in test_loader:\n",
        "            data, target = data.to(device), target.to(device)  # 데이터를 GPU로 이동\n",
        "            output = model(data)\n",
        "            test_loss += criterion(output, target).item()  # 손실 누적\n",
        "            pred = output.argmax(dim=1, keepdim=True)  # 최댓값을 정답으로 예측\n",
        "            correct += pred.eq(target.view_as(pred)).sum().item()  # 정답 개수\n",
        "\n",
        "    test_loss /= len(test_loader)  # 평균 손실 계산\n",
        "    test_losses.append(test_loss)\n",
        "\n",
        "    accuracy = 100. * correct / len(test_loader.dataset)\n",
        "    test_accuracies.append(accuracy)\n",
        "\n",
        "    print(f'\\nTest set: Average loss: {test_loss:.4f}, Accuracy: {correct}/{len(test_loader.dataset)} '\n",
        "          f'({accuracy:.2f}%)\\n')\n"
      ],
      "metadata": {
